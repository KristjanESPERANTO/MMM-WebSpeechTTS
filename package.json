{
  "name": "mmm-webspeechtts",
  "version": "0.1.2",
  "description": "Text-To-Speech module for MagicMirror².",
  "keywords": [
    "MagicMirror",
    "text-to-speech",
    "TTS",
    "WebSpeech"
  ],
  "type": "commonjs",
  "homepage": "https://github.com/KristjanESPERANTO/MMM-WebSpeechTTS#readme",
  "bugs": {
    "url": "https://github.com/KristjanESPERANTO/MMM-WebSpeechTTS/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KristjanESPERANTO/MMM-WebSpeechTTS"
  },
  "license": "MIT",
  "author": "Kristjan ESPERANTO",
  "main": "MMM-WebSpeechTTS.js",
  "scripts": {
    "demo": "cd ../../ && (speech-dispatcher -s -t 0 & true) && MM_CONFIG_FILE=modules/MMM-WebSpeechTTS/demo.config.js ./node_modules/.bin/electron js/electron.js --ozone-platform=wayland --enable-speech-dispatcher",
    "lint": "eslint && prettier --check .",
    "lint:fix": "eslint --fix && prettier . --write",
    "prepare": "node -e \"try{require('simple-git-hooks').run()}catch(e){}\"",
    "release": "commit-and-tag-version --config ./changelog.config.js",
    "test": "node --run lint && node --run test:unit && node --run test:spelling",
    "test:unit": "node --test tests/*.test.mjs",
    "test:spelling": "cspell ."
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.1",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "commit-and-tag-version": "^13.2.1",
    "cspell": "^10.3.6",
    "eslint": "^10.12.0",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0"
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true,
    "unrs-resolver@1.12.2": true
  }
}
